spring.application.name=management
server.port=8080

# SQL Server Configuration
# Default SQL Server port is 1433. Change if your instance uses a different port.
# You can also use environment variables: ${DB_PORT:1433}, ${DB_USERNAME:sa}, ${DB_PASSWORD:YOUR_SQL_PASSWORD}
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=AuraCoffeeDB;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=YOUR_SQL_PASSWORD

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect

# JWT Configuration
# IMPORTANT: Change this secret key before deploying to production!
# The secret must be at least 256 bits (32 characters) long.
jwt.secret=CHANGE_ME_TO_A_SECURE_SECRET_KEY_AT_LEAST_256_BITS
jwt.expiration-ms=28800000